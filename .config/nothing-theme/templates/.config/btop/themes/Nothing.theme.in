#Bashtop Adwaita Dark theme
#by k0tran

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="$black"

# Main text color
theme[main_fg]="$text"

# Title color for boxes
theme[title]="#DDDDDD"

# Highlight color for keyboard shortcuts
theme[hi_fg]="$text"

# Background color of selected item in processes box
theme[selected_bg]="$raised" 

# Foreground color of selected item in processes box
theme[selected_fg]="#FFFFFF"

# Color of inactive/disabled text
theme[inactive_fg]="$muted"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#565656"

# Cpu box outline color
theme[cpu_box]="#777777"

# Memory/disks box outline color
theme[mem_box]="#777777"

# Net up/down box outline color
theme[net_box]="#777777"

# Processes box outline color
theme[proc_box]="#777777"

# Box divider line and small boxes line color
theme[div_line]="#777777"

# Temperature graph colors
theme[temp_start]="#989898"
theme[temp_mid]="#666666"
theme[temp_end]="#454545"

# CPU graph colors
theme[cpu_start]="#989898"
theme[cpu_mid]="#666666"
theme[cpu_end]="#454545"

# Mem/Disk free meter
theme[free_start]="#989898"
theme[free_mid]="#666666"
theme[free_end]="#3E3E3E"

# Mem/Disk cached meter
theme[cached_start]="#989898"
theme[cached_mid]="#666666"
theme[cached_end]="#3E3E3E"

# Mem/Disk available meter
theme[available_start]="#989898"
theme[available_mid]="#666666"
theme[available_end]="#3E3E3E"

# Mem/Disk used meter
theme[used_start]="#989898"
theme[used_mid]="#666666"
theme[used_end]="#3E3E3E"

# Download graph colors
theme[download_start]="#989898"
theme[download_mid]="#666666"
theme[download_end]="#3E3E3E"

# Upload graph colors
theme[upload_start]="#989898"
theme[upload_mid]="#666666"
theme[upload_end]="#3E3E3E"
